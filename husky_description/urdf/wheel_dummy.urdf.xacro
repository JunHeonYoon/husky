<?xml version="1.0"?>

<robot xmlns:xacro="http://ros.org/wiki/xacro" name="husky_wheel">

  <xacro:macro name="husky_wheel_dummy" params="wheel_prefix *joint_pose">
    <link name="${wheel_prefix}_wheel_dummy">
      <inertial>
        <mass value="2.637" />
        <origin xyz="0 0 0" />
        <inertia  ixx="0.02467" ixy="0" ixz="0" iyy="0.04411" iyz="0" izz="0.02467" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://husky_description/meshes/wheel.dae" />
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${M_PI/2} 0 0" />
        <geometry>
          <cylinder length="${wheel_length}" radius="${wheel_radius}" />
        </geometry>
      </collision>
    </link>

    <joint name="${wheel_prefix}_wheel_dummy_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${wheel_prefix}_wheel_dummy"/>
      <xacro:insert_block name="joint_pose"/>
    </joint>

  </xacro:macro>
</robot>
